# Copia in ".env" (escluso da git) e riempi i valori.

# --- comuni ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
TELEGRAM_ALLOWED_USER_ID=

# --- solo per la modalita' WEBHOOK (bot/webhook.py, deploy su Render) ---
# stringa casuale per verificare che le richieste arrivino da Telegram
WEBHOOK_SECRET=
# URL pubblico del servizio (in locale per test; su Render arriva da RENDER_EXTERNAL_URL)
WEBHOOK_URL=
