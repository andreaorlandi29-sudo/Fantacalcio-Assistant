# Copia questo file in ".env" e riempi i valori.
# Il file ".env" e' escluso da git (vedi .gitignore): NON verra' committato.

# Token del bot Telegram (da @BotFather)
TELEGRAM_BOT_TOKEN=

# Chiave API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Opzionale: modello Claude (default claude-opus-5). Per contenere i costi: claude-sonnet-5
CLAUDE_MODEL=claude-opus-5

# Opzionale: se impostato, il bot risponde SOLO a questo user id Telegram
TELEGRAM_ALLOWED_USER_ID=
